[Unit]
Description=Auto-pricing daemon (per-provider orderbook, official-price trigger area basis B) — undercut/resume kompetitor per upstream/model
After=network.target

[Service]
Type=simple
# User-scoped unit → JANGAN set User=/Group= (status=216/GROUP pitfall)
WorkingDirectory=/home/gamesim
ExecStart=/home/gamesim/.venv-dash/bin/python3 /home/gamesim/scripts/auto_pricing.py --interval 60
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
